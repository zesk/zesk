{
	"authors": [
		{
			"email": "projects@marketacumen.com",
			"name": "Kent Davidson"
		}
	],
	"autoload": {
		"psr-4": {
			"zesk\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"testZesk\\": "tests/testZesk"
		}
	},
	"bin": [
		"bin/zesk.sh",
		"bin/zesk-command.php"
	],
	"description": "The Zesk Application Framework",
	"homepage": "https://php.zesk.com",
	"keywords": [
		"zesk",
		"application",
		"framework"
	],
	"license": "MIT",
	"name": "zesk/zesk",
	"require": {
		"components/jquery": "^3.7.1",
		"doctrine/dbal": "^3.8.2",
		"doctrine/orm": "^3.5.7",
		"ext-calendar": "*",
		"ext-curl": "*",
		"ext-gd": "*",
		"ext-intl": "*",
		"ext-json": "*",
		"ext-mysqli": "*",
		"ext-pcntl": "*",
		"ext-posix": "*",
		"ext-readline": "*",
		"ext-sockets": "*",
		"php": ">=8.1",
		"psr/cache": "^3",
		"psr/log": "^3.0.2"
	},
	"require-dev": {
		"ext-ftp": "*",
		"friendsofphp/php-cs-fixer": ">=3.75",
		"phpunit/php-code-coverage": "^10.1",
		"phpunit/php-invoker": ">=4",
		"phpunit/phpunit": ">=10"
	},
	"scripts": {},
	"suggest": {
		"ext-imap": "*",
		"ext-xdebug": "*"
	},
	"type": "library"
}
