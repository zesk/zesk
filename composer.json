{
	"name": "zesk/zesk",
	"description": "The Zesk Application Framework",
	"require": {
		"php": ">=8.1",
		"psr/log": "^3",
		"components/jquery": "^3.2",
		"psr/cache": "^3",
		"ext-calendar": "*",
		"ext-json": "*",
		"ext-posix": "*",
		"ext-pcntl": "*",
		"ext-intl": "*",
		"doctrine/orm": "^3"
	},
	"suggest": {
		"ext-xdebug": "*",
		"ext-curl": "*",
		"ext-imap": "*",
		"ext-readline": "*"
	},
	"require-dev": {
		"phpunit/phpunit": ">=10",
		"phpunit/php-invoker": "*",
		"friendsofphp/php-cs-fixer": "*",
		"ext-ftp": "*"
	},
	"authors": [
		{
			"name": "Kent Davidson",
			"email": "projects@marketacumen.com"
		}
	],
	"scripts": {},
	"keywords": [
		"zesk",
		"application",
		"framework"
	],
	"autoload": {
		"psr-4": {
			"zesk\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"test\\zesk\\": "test/zesk"
		}
	},
	"bin": [
		"bin/zesk.sh",
		"bin/zesk-command.php",
		"bin/zesk"
	],
	"type": "library",
	"license": "MIT",
	"homepage": "https://php.zesk.com",
	"version": "0.32.0"
}
